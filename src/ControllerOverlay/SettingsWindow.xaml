<Window x:Class="ControllerOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuracoes do Overlay" Height="720" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Foreground="#F5F7FA">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F111A" Offset="0.0"/>
            <GradientStop Color="#1A1829" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#88151720"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#00FFCC"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8DCE6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E94A3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#F4F6FB"/>
            <Setter Property="Foreground" Value="#111318"/>
            <Setter Property="CaretBrush" Value="#111318"/>
            <Setter Property="SelectionBrush" Value="#00FFCC"/>
            <Setter Property="BorderBrush" Value="#6B7280"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#F4F6FB"/>
            <Setter Property="Foreground" Value="#111318"/>
            <Setter Property="BorderBrush" Value="#6B7280"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#F4F6FB"/>
            <Setter Property="Foreground" Value="#111318"/>
            <Setter Property="Padding" Value="7,4"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E9EDF5"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2200FFCC"/>
            <Setter Property="Foreground" Value="#EAFDF8"/>
            <Setter Property="BorderBrush" Value="#7700FFCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#00FFCC"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#66000000"
                BorderBrush="#33FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="20,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Painel de configuracoes"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#F5F7FA"/>
                    <TextBlock Text="Ajustes aplicados na hora no overlay."
                               Foreground="#8E94A3"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#2200FFCC"
                        BorderBrush="#8800FFCC"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <TextBlock Text="Ctrl+Shift+C"
                               Foreground="#00FFCC"
                               FontWeight="Bold"
                               FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Aparencia do overlay" Style="{StaticResource SectionTitle}"/>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Modelo" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbLayout" Grid.Column="1" SelectionChanged="Setting_Changed">
                                <ComboBoxItem Content="Auto" />
                                <ComboBoxItem Content="Xbox" />
                                <ComboBoxItem Content="PlayStation" />
                                <ComboBoxItem Content="Teclado/Mouse" />
                            </ComboBox>
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="76"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Modelo teclado" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="Usado quando Modelo = Teclado/Mouse" Style="{StaticResource HintText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbKeyboardPreset"
                                      Grid.Column="1"
                                      Margin="0,0,8,0"
                                      DropDownOpened="CmbKeyboardPreset_DropDownOpened"
                                      SelectionChanged="Setting_Changed">
                            </ComboBox>
                            <Button Grid.Column="2"
                                    Content="Pasta"
                                    Height="32"
                                    Padding="10,0"
                                    ToolTip="Abrir pasta para adicionar modelos keyboard.json"
                                    Click="OpenKeyboardFolder_Click"/>
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tema visual" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbTheme" Grid.Column="1" SelectionChanged="Setting_Changed">
                                <ComboBoxItem Content="Neon" />
                                <ComboBoxItem Content="Limpo" />
                                <ComboBoxItem Content="Preto" />
                            </ComboBox>
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tamanho" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="SldScale" Grid.Column="1" Minimum="0.75" Maximum="3.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Setting_Changed"/>
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Opacidade" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="SldOpacity" Grid.Column="1" Minimum="0.1" Maximum="1.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Setting_Changed"/>
                        </Grid>

                        <CheckBox x:Name="ChkTransparentBg" Content="Fundo transparente" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <TextBlock Text="Desmarque para deixar um fundo preto atras do controle." Style="{StaticResource HintText}" Margin="22,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Controle" Style="{StaticResource SectionTitle}"/>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Deadzone" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="SldDeadzone" Grid.Column="1" Minimum="0.0" Maximum="0.5" Value="0.08" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="Setting_Changed"/>
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cor destaque" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Column="1">
                                <Border Width="190"
                                        Height="190"
                                        HorizontalAlignment="Left"
                                        Background="#22000000"
                                        BorderBrush="#44FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="95"
                                        Padding="5">
                                    <Image x:Name="ColorWheelImage"
                                           Width="180"
                                           Height="180"
                                           Stretch="None"
                                           Cursor="Cross"
                                           MouseDown="ColorWheel_MouseDown"
                                           MouseMove="ColorWheel_MouseMove"
                                           MouseUp="ColorWheel_MouseUp"/>
                                </Border>

                                <TextBlock Text="Brilho" Style="{StaticResource HintText}" Margin="0,8,0,3"/>
                                <Slider x:Name="SldColorValue"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="1"
                                        TickFrequency="0.01"
                                        ValueChanged="ColorValue_Changed"/>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border x:Name="AccentPreview"
                                            Width="24"
                                            Height="24"
                                            CornerRadius="12"
                                            Background="#00FFCC"
                                            BorderBrush="#E8EEF7"
                                            BorderThickness="1.5"/>
                                    <TextBlock Text="Cor atual"
                                               Style="{StaticResource HintText}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </StackPanel>

                                <TextBox x:Name="TxtAccentColor" Visibility="Collapsed" TextChanged="Setting_Changed"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="HUD de FPS e bola" Style="{StaticResource SectionTitle}"/>

                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <CheckBox x:Name="ChkShowFps" Content="Mostrar FPS" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="ChkShowBallSpeed" Content="Velocidade da bola" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        </UniformGrid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tamanho HUD" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="SldStatsScale" Grid.Column="1" Minimum="0.6" Maximum="2.5" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Setting_Changed"/>
                        </Grid>

                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Porta Stats API" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="Padrao 49123" Style="{StaticResource HintText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="TxtFpsPort" Grid.Column="1" TextChanged="Setting_Changed"/>
                        </Grid>

                        <TextBlock Text="Posicao na tela" Style="{StaticResource FieldLabel}" Margin="0,2,0,6"/>
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="X" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtStatsLeft" TextChanged="Setting_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Y" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtStatsTop" TextChanged="Setting_Changed"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ChkStatsTransparentBg" Content="Remover fundo preto do HUD" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="ChkStatsMovable" Content="Permitir arrastar HUD pelo mouse" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <TextBlock Text="Quando ligado, o HUD de FPS/bola pode ser arrastado mesmo com o overlay em click-through." Style="{StaticResource HintText}" Margin="22,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Comportamento" Style="{StaticResource SectionTitle}"/>

                        <UniformGrid Columns="2">
                            <CheckBox x:Name="ChkClickThrough" Content="Click-through" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="ChkAlwaysOnTop" Content="Sempre por cima" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="ChkLockPosition" Content="Travar posicao" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="ChkDebugMode" Content="Modo debug" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Atalhos" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Ctrl+Shift+O" Foreground="#F5F7FA" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Grid.Column="1" Text="Mostrar/ocultar overlay" Foreground="#C9CEDA" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Text="Ctrl+Shift+C" Foreground="#F5F7FA" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Abrir/fechar configuracoes" Foreground="#C9CEDA"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Creditos" Style="{StaticResource SectionTitle}"/>
                        <TextBlock FontWeight="Normal" Foreground="#E8EEF7">
                            <Run Text="Desenvolvido por CATATAU - "/>
                            <Hyperlink NavigateUri="https://github.com/Catatatau" RequestNavigate="GithubLink_RequestNavigate">
                                <Run Text="github.com/Catatatau"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
