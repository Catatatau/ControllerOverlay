<UserControl x:Class="ControllerOverlay.ControllerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="BtnText">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="FaceBtnText" BasedOn="{StaticResource BtnText}">
            <Setter Property="FontSize" Value="9.5"/>
        </Style>

        <Style TargetType="Border" x:Key="TriggerBorder">
            <Setter Property="BorderBrush" Value="#E8EEF7"/>
            <Setter Property="BorderThickness" Value="1.6"/>
            <Setter Property="Background" Value="#08000000"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder" Background="Transparent" Padding="0">
        <Canvas Width="245" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Left Bumpers / Triggers -->
            <StackPanel Canvas.Left="35" Canvas.Top="10" Width="52">
                <!-- LT -->
                <Grid Height="17" Margin="0,0,0,3">
                    <Border x:Name="LT_Outline" Style="{StaticResource TriggerBorder}" CornerRadius="2,2,1,1" />
                    <Border x:Name="LT_Fill" Background="#E8EEF7" CornerRadius="1" Margin="1.5" Opacity="0"/>
                    <TextBlock x:Name="Lbl_LT" Text="LT" Foreground="#E0E0E0" Style="{StaticResource BtnText}"/>
                </Grid>
                <!-- LB -->
                <Grid Height="17">
                    <Border x:Name="LB_Outline" Style="{StaticResource TriggerBorder}" CornerRadius="0" />
                    <Border x:Name="LB_Fill" Background="#E8EEF7" CornerRadius="0" Margin="1.5" Opacity="0"/>
                    <TextBlock x:Name="Lbl_LB" Text="LB" Foreground="#E0E0E0" Style="{StaticResource BtnText}"/>
                </Grid>
            </StackPanel>

            <!-- Right Bumpers / Triggers -->
            <StackPanel Canvas.Left="158" Canvas.Top="10" Width="52">
                <!-- RT -->
                <Grid Height="17" Margin="0,0,0,3">
                    <Border x:Name="RT_Outline" Style="{StaticResource TriggerBorder}" CornerRadius="2,2,1,1" />
                    <Border x:Name="RT_Fill" Background="#E8EEF7" CornerRadius="1" Margin="1.5" Opacity="0"/>
                    <TextBlock x:Name="Lbl_RT" Text="RT" Foreground="#E0E0E0" Style="{StaticResource BtnText}"/>
                </Grid>
                <!-- RB -->
                <Grid Height="17">
                    <Border x:Name="RB_Outline" Style="{StaticResource TriggerBorder}" CornerRadius="0" />
                    <Border x:Name="RB_Fill" Background="#E8EEF7" CornerRadius="0" Margin="1.5" Opacity="0"/>
                    <TextBlock x:Name="Lbl_RB" Text="RB" Foreground="#E0E0E0" Style="{StaticResource BtnText}"/>
                </Grid>
            </StackPanel>

            <!-- Left Stick -->
            <Grid Canvas.Left="34" Canvas.Top="70" Width="54" Height="54">
                <Ellipse x:Name="LeftStickBase" Stroke="#E8EEF7" StrokeThickness="3.5" Opacity="0.98"/>
                <Ellipse x:Name="LeftStick" Fill="#C5C8CF" Width="35" Height="35"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="LeftStickTranslate" X="0" Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <!-- Face Buttons -->
            <Canvas Canvas.Left="151" Canvas.Top="64" Width="66" Height="66">
                <!-- Y -->
                <Grid Canvas.Left="22" Canvas.Top="0" Width="22" Height="22">
                    <Ellipse x:Name="Btn_Y" Stroke="#F1C40F" StrokeThickness="1.9" Fill="Transparent"/>
                    <TextBlock x:Name="Lbl_Y" Text="Y" Foreground="#F1C40F" Style="{StaticResource FaceBtnText}"/>
                </Grid>
                <!-- X -->
                <Grid Canvas.Left="0" Canvas.Top="22" Width="22" Height="22">
                    <Ellipse x:Name="Btn_X" Stroke="#004DFF" StrokeThickness="1.9" Fill="Transparent"/>
                    <TextBlock x:Name="Lbl_X" Text="X" Foreground="#004DFF" Style="{StaticResource FaceBtnText}"/>
                </Grid>
                <!-- B -->
                <Grid Canvas.Left="44" Canvas.Top="22" Width="22" Height="22">
                    <Ellipse x:Name="Btn_B" Stroke="#D9192E" StrokeThickness="1.9" Fill="Transparent"/>
                    <TextBlock x:Name="Lbl_B" Text="B" Foreground="#D9192E" Style="{StaticResource FaceBtnText}"/>
                </Grid>
                <!-- A -->
                <Grid Canvas.Left="22" Canvas.Top="44" Width="22" Height="22">
                    <Ellipse x:Name="Btn_A" Stroke="#00B83F" StrokeThickness="1.9" Fill="Transparent"/>
                    <TextBlock x:Name="Lbl_A" Text="A" Foreground="#00B83F" Style="{StaticResource FaceBtnText}"/>
                </Grid>
            </Canvas>
        </Canvas>
    </Border>
</UserControl>
